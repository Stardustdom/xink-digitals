# ==========================================
# Webmail SMTP Configuration (cPanel / Custom Domain)
# ==========================================
# 1. SMTP Server / Host for your domain:
#    Defaults to mail.xinkdigitals.com (or your hosting server hostname / IP)
SMTP_HOST=mail.xinkdigitals.com

# 2. SMTP Port (465 for SSL, or 587 for TLS):
SMTP_PORT=465

# 3. Webmail username:
SMTP_USER=contact@xinkdigitals.com

# 4. Webmail password (the password you use to log into webmail):
SMTP_PASS=your_webmail_password_here

NEXT_PUBLIC_SITE_URL=https://xinkdigitals.com
